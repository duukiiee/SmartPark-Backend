generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int       @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String    @unique
  schoolId         String    @unique
  phone            String?
  avatar           String?
  password         String
  role             String    @default("USER")
  accountType      String    @default("STUDENT")
  accountStatus    String    @default("Active") // "Active", "Inactive", "Suspended", "Deactivated"
  suspendedUntil   DateTime?
  suspensionReason String?
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicles      Vehicle[]
  incidents     Incident[]
  notifications Notification[]
  appeals       Appeal[]

  @@index([role, accountStatus])
  @@map("user")
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  userId             Int?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String // "Car" | "Motorcycle"
  plateNumber        String    @unique
  brand              String
  model              String
  color              String
  year               String
  status             String    @default("Pending") // "Pending", "Approved", "Rejected", "Inactive"
  rejectionReason    String?
  ownerName          String? // Added for high-performance gate registration lookup
  idType             String? // Added for high-performance gate registration lookup
  idNumber           String? // Added for high-performance gate registration lookup
  qrCode             String?   @unique
  registrationSource String    @default("Online")
  photo              String?   @db.Text
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  parkingLogs ParkingLog[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([registrationSource, status])
  @@index([registrationSource, createdAt])
  @@index([plateNumber])
  @@index([qrCode])
  @@map("vehicle")
}

model ParkingLog {
  id        Int       @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  entryTime DateTime  @default(now())
  exitTime  DateTime?
  duration  String?
  status    String    @default("Currently Parked")
  guardName String    @default("Guard Santos")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([vehicleId, entryTime])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([entryTime])
  @@index([exitTime])
  @@index([status])
  @@map("parking_log")
}

model ParkingSetting {
  id                 Int      @id @default(autoincrement())
  carCapacity        Int      @default(60)
  motorcycleCapacity Int      @default(40)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("parking_setting")
}

model Incident {
  id              Int       @id @default(autoincrement())
  referenceId     String    @unique
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  reporterName    String
  reporterEmail   String?
  reporterPhone   String?
  vehicleType     String // "Car" | "Motorcycle" | "Car (Sedan)"
  plateNumber     String
  model           String?
  color           String?
  reportType      String // "Obstruction" | "Illegal Parking" | "Double parking" | "Blocking parking space" | "Minor Scratch"
  description     String
  evidenceImage   String?   @db.Text
  status          String    @default("Pending") // "Pending", "Reviewed", "Rejected", "Unidentified"
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([plateNumber])
  @@index([createdAt])
  @@map("incident")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String // SHA-256 hashed code
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String // 6-digit code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int? // specific admin user, or null for broadcast to all admins
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        String   @default("alert") // "alert" | "update" | "warning"
  link        String? // target link (e.g. "/admin/incidents", "/admin/vehicles/registration")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notification")
}

model VehicleSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @default("options")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_setting")
}

model Appeal {
  id             Int       @id @default(autoincrement())
  referenceId    String    @unique
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  reason         String
  additionalInfo String?
  status         String    @default("Pending") // "Pending", "Approved", "Rejected"
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("appeal")
}
