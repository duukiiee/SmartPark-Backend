generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String    @unique
  schoolId      String    @unique
  phone         String?
  avatar        String?
  password      String
  role          String    @default("USER")
  accountType   String    @default("STUDENT")
  accountStatus String    @default("Active") // "Active", "Inactive", "Suspended", "Deactivated"
  suspendedUntil DateTime?
  suspensionReason String?
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicles      Vehicle[]

  @@map("user")
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               String    // "Car" | "Motorcycle"
  plateNumber        String    @unique
  brand              String
  model              String
  color              String
  year               String
  status             String    @default("Pending") // "Pending", "Approved", "Rejected", "Inactive"
  rejectionReason    String?
  qrCode             String?   @unique
  registrationSource String    @default("Online")
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("vehicle")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String   // SHA-256 hashed code
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String   // 6-digit code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}